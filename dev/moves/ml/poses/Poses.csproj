<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Auslender.Poses</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NOTE (mristin):
      We compile the Godot-free sources of the vision directly, as the tests do,
      so that the poses for the training come from the same code as in the game.
    -->
    <Compile Include="../../../../scenes/vision/core/*.cs" LinkBase="Linked/vision" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>
</Project>
