<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Auslender.Replay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NOTE (mristin):
      We compile the Godot-free sources of the vision directly, as the tests do.
    -->
    <Compile Include="../../scenes/vision/core/*.cs" LinkBase="Linked/vision" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>
</Project>
